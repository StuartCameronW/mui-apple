{
  "name": "mui-apple",
  "version": "1.1.0",
  "description": "Apple-inspired UI theme for Material-UI with comprehensive color palette and component styling",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "./dist/register-fonts.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./register-fonts": {
      "types": "./dist/register-fonts.d.ts",
      "import": "./dist/register-fonts.js",
      "default": "./dist/register-fonts.js"
    },
    "./colors": {
      "types": "./dist/colors.d.ts",
      "import": "./dist/colors.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    }
  },
  "packageManager": "pnpm@10.28.0",
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "cd example && pnpm dev",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "apple",
    "theme",
    "material-ui",
    "mui",
    "react",
    "typescript",
    "ui",
    "design-system"
  ],
  "author": "Stuart Wisskirchen",
  "license": "MIT",
  "peerDependencies": {
    "@mui/material": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "mui-color-input": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@mui/material": "^7.3.5",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "mui-color-input": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StuartCameronW/mui-apple.git"
  },
  "bugs": {
    "url": "https://github.com/StuartCameronW/mui-apple/issues"
  },
  "homepage": "https://github.com/StuartCameronW/mui-apple#readme",
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/open-sans": "^5.2.7",
    "geist": "^1.5.1",
    "lucide-react": "^0.539.0"
  }
}
